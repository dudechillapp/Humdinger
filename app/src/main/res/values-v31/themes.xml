<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system splash. Make it a plain cream screen (no icon)
         so it blends straight into the app's own loading screen. -->
    <style name="Theme.Humdinger" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:windowSplashScreenBackground">@color/cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
