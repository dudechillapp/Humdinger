rules_version = '2';

// Humdinger database rules.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Storage allowance guard (config/storage, set hourly by the server): videos pause first,
    // then all new recordings, when this month's free storage allowance is nearly used up.
    function allowsRecording(mediaType) {
      let cfg = /databases/$(database)/documents/config/storage;
      return !exists(cfg)
        || get(cfg).data.get('mode', 'normal') == 'normal'
        || (get(cfg).data.get('mode', 'normal') == 'audioOnly' && mediaType == 'audio');
    }

    // True if this person has blocked me.
    function blockedMe(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/blocked/$(me()));
    }

    // Keep in sync with data/Links.kt in the app. YouTube, Spotify, Apple Music, Amazon Music,
    // Deezer, SoundCloud, TIDAL, Shazam and song.link.
    function isMusicLink(url) {
      return url is string
        && url.size() < 300
        && url.matches('https://((www[.]|m[.]|music[.])?youtube[.]com|youtu[.]be|open[.]spotify[.]com|spotify[.]link|music[.]apple[.]com|music[.]amazon[.](com|co[.]uk|de|fr|it|es|ca|in|co[.]jp|com[.]au|com[.]br|com[.]mx)|(www[.]|link[.])?deezer[.]com|deezer[.]page[.]link|(www[.]|m[.]|on[.])?soundcloud[.]com|(www[.]|listen[.])?tidal[.]com|(www[.])?shazam[.]com|song[.]link|album[.]link)/.+');
    }

    // ---------- Names (one document per name, so names stay unique) ----------
    // Names are generated by the app, e.g. "Lazy Frog" → key "lazy_frog".
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && name.matches('[a-z0-9_]{3,30}');
      // Release your old name when you change it.
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ---------- User profiles ----------
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && uid == me()
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'points', 'solvedCount', 'createdAt'])
        && request.resource.data.points == 0
        && request.resource.data.solvedCount == 0
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 30
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == me();

      // Nobody can edit their own points. Points only change when a requester
      // crowns a guess, in the same atomic write that marks their request solved.
      allow update: if signedIn() && (isRename(uid) || isSettingsUpdate(uid) || isPushTokenUpdate(uid)
                                      || isRulesAccept(uid) || isNotifyUpdate(uid) || isPrivacyUpdate(uid)
                                      || isAward(uid));

      // People this person has blocked. Private: only they can see or change the list.
      match /blocked/{otherUid} {
        allow read, delete: if signedIn() && uid == me();
        allow create: if signedIn()
          && uid == me()
          && otherUid != me()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'blockedAt'])
          && request.resource.data.uid == otherUid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 30
          && request.resource.data.blockedAt == request.time;
      }

      // Friends. Written in pairs when someone accepts a friend request (both lists, plus deleting
      // the request, in one write). Either friend can end it.
      match /friends/{friendUid} {
        allow read: if signedIn() && uid == me();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'since', 'addedBy'])
          && request.resource.data.uid == friendUid
          && request.resource.data.addedBy == me()
          && request.resource.data.since == request.time
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 30
          && (
            // My list: they asked me.
            (uid == me() && friendUid != me() && friendRequestExists(friendUid, me()))
            // Their list: they asked me, and it's my real name going on it.
            || (friendUid == me() && uid != me() && friendRequestExists(uid, me())
                && request.resource.data.name == get(/databases/$(database)/documents/users/$(me())).data.username)
          );
        // After a name change, your name on your friends' lists.
        allow update: if signedIn()
          && friendUid == me()
          && changedKeys().hasOnly(['name'])
          && request.resource.data.name == get(/databases/$(database)/documents/users/$(me())).data.username;
        allow delete: if signedIn() && (uid == me() || friendUid == me());
      }

      // Songs this person has named: a permanent record, written when the requester crowns them,
      // in the same write that marks the request solved.
      match /solved/{reqId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.requesterId == me()
          && get(/databases/$(database)/documents/requests/$(reqId)).data.status == 'open'
          && getAfter(/databases/$(database)/documents/requests/$(reqId)).data.status == 'solved'
          && getAfter(/databases/$(database)/documents/requests/$(reqId)).data.ownerId == me()
          && getAfter(/databases/$(database)/documents/requests/$(reqId)).data.solverId == uid;
      }
    }

    function friendRequestExists(fromUid, toUid) {
      return exists(/databases/$(database)/documents/friendRequests/$(fromUid + '_' + toUid));
    }

    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/friends/$(b));
    }

    // Notification settings (NotifyType in the app). Keep the keys in sync.
    function isNotifyUpdate(uid) {
      return uid == me()
        && changedKeys().hasOnly(['notify'])
        && request.resource.data.notify is map
        && request.resource.data.notify.keys().hasOnly(['all', 'guesses', 'comments', 'replies', 'crowned',
             'thanks', 'chat', 'friendRequests', 'friendHums', 'allHums', 'removed',
             'quietOn', 'quietStart', 'quietEnd', 'daily', 'digestHour', 'tz']);
    }

    // Privacy settings (Privacy in the app). Keep the keys and values in sync.
    function isPrivacyUpdate(uid) {
      let p = request.resource.data.privacy;
      return uid == me()
        && changedKeys().hasOnly(['privacy'])
        && p is map
        && p.keys().hasOnly(['friendRequests', 'messages', 'comments', 'leaderboard'])
        && p.get('friendRequests', 'everyone') in ['everyone', 'nobody']
        && p.get('messages', 'friends') in ['friends', 'nobody']
        && p.get('comments', 'everyone') in ['everyone', 'friends', 'nobody']
        && p.get('leaderboard', true) is bool;
    }

    // Someone's privacy setting, e.g. privacyOf(uid, 'comments', 'everyone').
    function privacyOf(uid, key, fallback) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('privacy', {}).get(key, fallback);
    }

    // This phone's push-notification address(es) for the account.
    function isPushTokenUpdate(uid) {
      return uid == me()
        && changedKeys().hasOnly(['fcmTokens'])
        && request.resource.data.fcmTokens is list
        && request.resource.data.fcmTokens.size() <= 10;
    }

    // Agreeing to the house rules (HouseRules.VERSION in the app).
    function isRulesAccept(uid) {
      return uid == me()
        && changedKeys().hasOnly(['rulesVersion'])
        && request.resource.data.rulesVersion is int
        && request.resource.data.rulesVersion >= 1
        && request.resource.data.rulesVersion <= 100;
    }

    // "Keep my recordings for" setting (days). Keep in sync with ClipLifetime in Models.kt.
    function isSettingsUpdate(uid) {
      return uid == me()
        && changedKeys().hasOnly(['clipLifetimeDays'])
        && request.resource.data.clipLifetimeDays in [1, 3, 7, 30, 90];
    }

    // Changing your own name: the new name must be reserved for you in the same write.
    function isRename(uid) {
      let d = request.resource.data;
      return uid == me()
        && changedKeys().hasOnly(['username', 'usernameLower'])
        && d.username is string
        && d.username.size() >= 3
        && d.username.size() <= 30
        && !d.username.lower().matches('.*(fuck|shit|cunt|nigg|faggot|bitch|whore|slut|porn|wank|twat|jizz|retard|hitler|nazi|hurensohn|wichser|fotze|arschloch|schlampe|scheiss|humdinger|moderator).*')
        && getAfter(/databases/$(database)/documents/usernames/$(d.usernameLower)).data.uid == me();
    }

    // Points must match data/Models.kt → Points (SOLVER = 20, PARTICIPANT = 5).
    function isAward(uid) {
      let reqPath = /databases/$(database)/documents/requests/$(request.resource.data.lastAwardFrom);
      let before = get(reqPath).data;
      let after = getAfter(reqPath).data;
      let pointsGained = request.resource.data.points - resource.data.points;
      let solvedGained = request.resource.data.solvedCount - resource.data.solvedCount;
      return changedKeys().hasOnly(['points', 'solvedCount', 'lastAwardFrom'])
        && before.status == 'open'
        && after.status == 'solved'
        && after.ownerId == me()
        && uid != me()
        && (
          (uid == after.solverId && pointsGained == 20 && solvedGained == 1)
          || (uid != after.solverId && uid in after.rewardedIds && pointsGained == 5 && solvedGained == 0)
        );
    }

    // ---------- Song requests (a hum or a mime) ----------
    match /requests/{reqId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.status == 'open'
        && request.resource.data.guessCount == 0
        && request.resource.data.mediaType in ['audio', 'video']
        && allowsRecording(request.resource.data.mediaType)
        && request.resource.data.hint is string
        && request.resource.data.hint.size() <= 140
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(91, 'd');

      allow update: if signedIn() && (isReactionUpdate() || isGuessCountUpdate() || isNameRefresh()
                                      || isExpiryUpdate() || isSolve());

      // The owner changes when their clip is deleted (their setting, or "Delete now").
      function isExpiryUpdate() {
        return resource.data.ownerId == me()
          && changedKeys().hasOnly(['expireAt'])
          && request.resource.data.expireAt is timestamp
          && request.resource.data.expireAt <= request.time + duration.value(91, 'd');
      }

      // After a name change, your requests and the songs you named show your new name
      // (and it must match your profile, so nobody can put words in your mouth).
      function isNameRefresh() {
        let newName = get(/databases/$(database)/documents/users/$(me())).data.username;
        return (changedKeys().hasOnly(['ownerName'])
            && resource.data.ownerId == me()
            && request.resource.data.ownerName == newName)
          || (changedKeys().hasOnly(['solverName'])
            && resource.data.solverId == me()
            && request.resource.data.solverName == newName);
      }

      function isReactionUpdate() {
        return changedKeys().hasOnly(['reactionCounts']);
      }

      function isGuessCountUpdate() {
        return changedKeys().hasOnly(['guessCount'])
          && request.resource.data.guessCount == resource.data.guessCount + 1;
      }

      // Only the requester can crown a guess, only once, and the winner must really
      // be the author of that guess.
      function isSolve() {
        let d = request.resource.data;
        return resource.data.status == 'open'
          && d.status == 'solved'
          && resource.data.ownerId == me()
          && changedKeys().hasOnly(['status', 'solvedGuessId', 'solverId', 'solverName', 'solvedTitle',
                                    'solvedArtist', 'solvedLink', 'solvedAt', 'rewardedIds'])
          && d.solverId != me()
          && get(/databases/$(database)/documents/requests/$(reqId)/guesses/$(d.solvedGuessId)).data.authorId == d.solverId
          && d.rewardedIds is list
          && d.rewardedIds.size() <= 30
          && !(me() in d.rewardedIds)
          && !(d.solverId in d.rewardedIds)
          && d.solvedAt == request.time;
      }

      // ---------- Guesses ----------
      match /guesses/{guessId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == me()
          && get(/databases/$(database)/documents/requests/$(reqId)).data.status == 'open'
          && get(/databases/$(database)/documents/requests/$(reqId)).data.ownerId != me()
          && !blockedMe(get(/databases/$(database)/documents/requests/$(reqId)).data.ownerId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && isMusicLink(request.resource.data.link)
          && (!('comment' in request.resource.data)
              || (request.resource.data.comment is string && request.resource.data.comment.size() <= 200))
          && request.resource.data.createdAt == request.time;

        // After a name change, your guesses show your new name.
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName'])
          && resource.data.authorId == me()
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(me())).data.username;
      }

      // ---------- Comments on a hum (anyone, kept friendly by the app's filter and by reports) ----------
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == me()
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(me())).data.username
          && !blockedMe(get(/databases/$(database)/documents/requests/$(reqId)).data.ownerId)
          && commentsAllowed(get(/databases/$(database)/documents/requests/$(reqId)).data.ownerId)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && request.resource.data.createdAt == request.time;

        // The hummer's "Who can comment on my hums" setting.
        function commentsAllowed(ownerId) {
          let choice = privacyOf(ownerId, 'comments', 'everyone');
          return ownerId == me()
            || choice == 'everyone'
            || (choice == 'friends' && areFriends(ownerId, me()));
        }

        // After a name change, your comments show your new name.
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName'])
          && resource.data.authorId == me()
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(me())).data.username;

        // Your own comment, or any comment on your own hum.
        allow delete: if signedIn()
          && (resource.data.authorId == me()
              || get(/databases/$(database)/documents/requests/$(reqId)).data.ownerId == me());
      }

      // ---------- Replies under a guess ("Same thought!", "Not it, but so close!") ----------
      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['guessId', 'guessAuthorId', 'authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == me()
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(me())).data.username
          && request.resource.data.guessId is string
          // The guess must exist on this request, and be by the person named in guessAuthorId.
          && get(/databases/$(database)/documents/requests/$(reqId)/guesses/$(request.resource.data.guessId)).data.authorId == request.resource.data.guessAuthorId
          // Not if the guesser or the requester has blocked you.
          && !blockedMe(request.resource.data.guessAuthorId)
          && !blockedMe(get(/databases/$(database)/documents/requests/$(reqId)).data.ownerId)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && request.resource.data.createdAt == request.time;

        // After a name change, your replies show your new name.
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName'])
          && resource.data.authorId == me()
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(me())).data.username;

        // You can take back your own reply.
        allow delete: if signedIn() && resource.data.authorId == me();
      }

      // ---------- Reports (one per person; enough of them and the server removes the request) ----------
      match /reports/{uid} {
        allow create: if signedIn()
          && uid == me()
          && get(/databases/$(database)/documents/requests/$(reqId)).data.ownerId != me()
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 100;
      }

      // ---------- Reactions (one per person per request) ----------
      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && uid == me()
          && request.resource.data.reaction in ['laugh', 'fire', 'clap', 'cringe', 'spot_on'];
        allow delete: if signedIn() && uid == me();
      }
    }

    // Lets the app find all of someone's guesses (across every request) when they rename.
    match /{path=**}/guesses/{guessId} {
      allow read: if signedIn();
    }
    match /{path=**}/replies/{replyId} {
      allow read: if signedIn();
    }
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn();
    }
    // Lets the app find your name on your friends' lists when you rename.
    match /{path=**}/friends/{friendUid} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    // ---------- Friend requests: friendRequests/<from>_<to> ----------
    match /friendRequests/{requestId} {
      // resource == null lets the app check whether someone has already asked you.
      allow read: if signedIn()
        && (resource == null || me() == resource.data.fromUid || me() == resource.data.toUid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'toUid', 'toName', 'createdAt'])
        && request.resource.data.fromUid == me()
        && request.resource.data.toUid is string
        && request.resource.data.toUid != me()
        && requestId == me() + '_' + request.resource.data.toUid
        && request.resource.data.fromName == get(/databases/$(database)/documents/users/$(me())).data.username
        && request.resource.data.toName is string
        && request.resource.data.toName.size() <= 30
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUid))
        && !blockedMe(request.resource.data.toUid)
        && privacyOf(request.resource.data.toUid, 'friendRequests', 'everyone') != 'nobody'
        && !areFriends(me(), request.resource.data.toUid)
        && request.resource.data.createdAt == request.time;
      // Accepting, declining or cancelling.
      allow delete: if signedIn() && (me() == resource.data.fromUid || me() == resource.data.toUid);
    }

    // ---------- Conversations: start with a thank-you (one per solved request), then chat ----------
    match /thanks/{reqId} {
      // resource == null lets the requester check whether they've already sent one.
      allow read: if signedIn() && (resource == null || me() in resource.data.members);

      allow create: if signedIn() && (isThanksCreate() || isFriendChatCreate());

      // A thank-you from the requester to whoever named their song (one per request).
      function isThanksCreate() {
        return request.resource.data.mediaType in ['text', 'audio', 'video']
          && request.resource.data.fromUid == me()
          && request.resource.data.members == [me(), request.resource.data.toUid]
          && get(/databases/$(database)/documents/users/$(request.resource.data.toUid)/solved/$(reqId)).data.requesterId == me()
          && !blockedMe(request.resource.data.toUid)
          && (request.resource.data.mediaType == 'text' || allowsRecording(request.resource.data.mediaType))
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.lastSenderId == me()
          && request.resource.data.createdAt == request.time
          && request.resource.data.lastAt == request.time
          && (request.resource.data.mediaType == 'text'
              || (request.resource.data.expireAt is timestamp
                  && request.resource.data.expireAt <= request.time + duration.value(91, 'd')));
      }

      // A chat between friends: thanks/f_<uid>_<uid>, ids in order.
      function isFriendChatCreate() {
        let d = request.resource.data;
        let other = d.toUid;
        return d.mediaType == 'friend'
          && d.fromUid == me()
          && other is string
          && other != me()
          && d.members == [me(), other]
          && (reqId == 'f_' + me() + '_' + other || reqId == 'f_' + other + '_' + me())
          && areFriends(me(), other)
          && !blockedMe(other)
          && privacyOf(other, 'messages', 'friends') != 'nobody'
          && d.lastSenderId == me()
          && d.createdAt == request.time
          && d.lastAt == request.time
          && !('expireAt' in d);
      }

      // Either person: new-message preview, read receipts, and blocking.
      allow update: if signedIn()
        && me() in resource.data.members
        && changedKeys().hasOnly(['lastMessage', 'lastAt', 'lastSenderId', 'readAt', 'blockedBy'])
        && (!('lastSenderId' in changedKeys()) || request.resource.data.lastSenderId == me())
        && (!('blockedBy' in changedKeys()) || isBlockChange());

      // You can block (if nobody has), or undo your own block.
      function isBlockChange() {
        let before = resource.data.get('blockedBy', null);
        let after = request.resource.data.get('blockedBy', null);
        return (before == null && after == me()) || (before == me() && after == null);
      }

      // The other person's "Who can message me" setting ("nobody" = no messages to them).
      function messagesAllowed(members) {
        let other = members[0] == me() ? members[1] : members[0];
        return privacyOf(other, 'messages', 'friends') != 'nobody';
      }

      match /messages/{messageId} {
        allow read: if signedIn()
          && me() in get(/databases/$(database)/documents/thanks/$(reqId)).data.members;
        allow create: if signedIn()
          && request.resource.data.senderId == me()
          && me() in get(/databases/$(database)/documents/thanks/$(reqId)).data.members
          && get(/databases/$(database)/documents/thanks/$(reqId)).data.get('blockedBy', null) == null
          && !blockedMe(get(/databases/$(database)/documents/thanks/$(reqId)).data.members[0])
          && !blockedMe(get(/databases/$(database)/documents/thanks/$(reqId)).data.members[1])
          && messagesAllowed(get(/databases/$(database)/documents/thanks/$(reqId)).data.members)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
      }
    }

    // Reports about conversations and guesses, for you to review in the Firebase console.
    match /chatReports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == me();
    }
    match /userReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == me()
        && request.resource.data.reportedUid != me()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 100;
    }
    match /guessReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == me()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 100;
    }

    // deletionRequests: written by you in the Firebase console to delete someone's account
    // (see SETUP.md). The app can't read or write them.

    // ---------- App settings written by the server (e.g. config/storage) ----------
    match /config/{docId} {
      allow read: if signedIn();
    }

    // ---------- Notices (e.g. "your request was removed after reports") ----------
    // Written by the server only; the person it's for can read it and mark it read.
    match /notices/{noticeId} {
      allow read: if signedIn() && resource.data.toUid == me();
      allow update: if signedIn()
        && resource.data.toUid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Removed-by-moderation records are written by the server only (see functions/index.js).
  }
}
